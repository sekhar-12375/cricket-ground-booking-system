# Application URL & Port
PORT=3000
APP_URL=http://localhost:3000

# Authentication Secret for JWT session tokens
AUTH_SECRET=cricket-ground-booking-super-secure-jwt-secret-key-2026

# Database Configuration (PostgreSQL / Supabase / Neon or embedded PGlite WASM fallback)
# Leave empty or set to embedded to use the zero-setup embedded PostgreSQL engine
DATABASE_URL=

# Payment Gateway Configuration
# Supported modes: DEMO | RAZORPAY | STRIPE
PAYMENT_MODE=DEMO
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=

# Notifications (Email / SMS optional for production, simulated in development)
EMAIL_API_KEY=
SMS_API_KEY=
